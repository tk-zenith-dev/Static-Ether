{
  "schema_version": "2.1.1",
  "ruleset_id": "com.tkzenith.staticether.ruleset.template.custom",
  "metadata": {
    "name": "Molde Estándar de Ruleset v2.1.1",
    "version": "1.1.20",
    "author": "TK-Zenith Core Security",
    "license": "GPL-3.0",
    "homepage": "https://github.com/tk-zenith-dev/Static-Ether",
    "created_at": "2026-11-22T00:00:00Z",
    "updated_at": "2026-11-22T00:00:00Z",
    "category": "custom",
    "description": {
      "es": "Plantilla molde oficial de especificación técnica Enterprise Schema v2.1.1 para creación, importación y auditoría de reglas de filtrado de red.",
      "en": "Official Enterprise Schema v2.1.1 template specification for creating, importing, and auditing network firewall rulesets.",
      "pt": "Modelo padrão de especificação técnica Enterprise Schema v2.1.1 para criação e importação de regras de rede.",
      "fr": "Modèle standard Enterprise Schema v2.1.1 pour la création et l'importation de règles réseau.",
      "de": "Offizielle Enterprise Schema v2.1.1 Vorlage zur Erstellung und zum Import von Netzwerkregeln.",
      "zh": "官方 Enterprise Schema v2.1.1 规则模版，用于网络防火墙规则创建与导入。"
    },
    "compatibility": {
      "min_engine_version": "2.0.0",
      "requires_root": false,
      "supported_architectures": [
        "arm64-v8a",
        "armeabi-v7a",
        "x86",
        "x86_64"
      ]
    }
  },
  "scope": {
    "type": "global",
    "target_packages": [
      "com.ejemplo.aplicacion"
    ],
    "target_package_signatures_sha256": [],
    "excluded_packages": [
      "com.tkzenith.staticether",
      "com.android.vending",
      "com.google.android.gms",
      "com.google.android.gsf",
      "com.android.providers.downloads"
    ]
  },
  "execution_policy": {
    "default_action": "ALLOW",
    "mode": "active_enforcement",
    "priority_weight": 800,
    "fast_path_enabled": true,
    "mtu_hint": 16384,
    "ipv6_handling": "STRICT_DUAL_STACK",
    "quic_policy": "VERSION_NEGOTIATION",
    "tcp_rejection_method": "TCP_RST",
    "dns_response_strategy": "A_0_0_0_0"
  },
  "network_rules": {
    "l3_cidr_rules": [
      {
        "cidr": "142.250.0.0/16",
        "action": "ALLOW",
        "direction": "OUTBOUND",
        "description": "Rango CDN autorizado"
      }
    ],
    "l4_transport_rules": [
      {
        "protocol": "TCP",
        "ports": [
          853
        ],
        "action": "BLOCK",
        "description": "Neutraliza DoT (DNS-over-TLS en puerto 853)"
      },
      {
        "protocol": "UDP",
        "ports": [
          443
        ],
        "action": "VERSION_NEGOTIATION",
        "description": "Degrada QUIC (HTTP/3) hacia TCP/TLS mediante RFC 9000"
      }
    ],
    "l7_dns": {
      "cname_flattening": true,
      "blocked_domains": [
        "ads.ejemplo.com",
        "*.tracking.ejemplo.com",
        "telemetry.ejemplo.com"
      ],
      "whitelist_exceptions": [
        "api.ejemplo.com",
        "auth.ejemplo.com",
        "play.googleapis.com"
      ],
      "glob_domains": [
        "ad-*.ejemplo.com",
        "pixel-*.ejemplo.com"
      ]
    },
    "l7_tls_sni": {
      "blocked_snis": [
        "ads-api.ejemplo.com",
        "dns.google",
        "cloudflare-dns.com"
      ],
      "whitelist_snis": [
        "cdn.ejemplo.com",
        "stream.ejemplo.com"
      ],
      "ja4_fingerprints_blacklist": [
        "t13d1516h2_8daaf6152771_010203040506"
      ]
    },
    "l7_http_mitm": {
      "enabled": false,
      "path_rewrites": [],
      "header_mutations": [],
      "json_body_strip_paths": []
    }
  },
  "telemetry_audit": {
    "log_level": "METADATA_ONLY",
    "rate_limit_per_second": 120,
    "ring_buffer_size_kb": 128,
    "alert_on_new_host": true
  }
}