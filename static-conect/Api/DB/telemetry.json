    "l4_transport_rules": [
      {
        "protocol": "TCP",
        "ports": [
          853
        ],
        "action": "BLOCK",
        "description": "Neutraliza DoT (DNS Privado)"
      },
      {
        "protocol": "UDP",
        "ports": [
          443
        ],
        "action": "BLOCK",
        "description": "Fuerza degradación de QUIC (HTTP/3) a TCP"
      }
