  "schema_version": "2.1.1",
  "ruleset_id": "com.tkzenith.staticether.ruleset.telemetry",
  "metadata": {
    "name": "Static Ether — Telemetría, Rastreo y Analítica",
    "version": "1.1.20",
    "author": "TK-Zenith Core Security",
    "license": "GPL-3.0",
    "homepage": "https://github.com/tk-zenith-dev/Static-Ether",
    "created_at": "2026-11-22T00:00:00Z",
    "updated_at": "2026-11-22T00:00:00Z",
    "category": "privacy",
    "description": {
      "es": "Protección integral contra recopilación de telemetría de comportamiento, huellas digitales de dispositivos y analítica intrusiva.",
      "en": "Comprehensive protection against behavioral telemetry collection, device fingerprinting, and intrusive analytics.",
      "pt": "Proteção integral contra coleta de telemetria comportamental e rastreamento de dispositivos."
    },
    "compatibility": {
      "min_engine_version": "2.0.0",
      "requires_root": false,
      "supported_architectures": [
        "arm64-v8a",
        "armeabi-v7a",
        "x86",
        "x86_64"
      ]
    }
  },
  "scope": {
    "type": "global",
    "target_packages": [],
    "excluded_packages": [
      "com.tkzenith.staticether"
    ]
  },
  "execution_policy": {
    "default_action": "ALLOW",
    "mode": "active_enforcement",
    "priority_weight": 850,
    "fast_path_enabled": true,
    "mtu_hint": 16384,
    "ipv6_handling": "STRICT_DUAL_STACK",
    "quic_policy": "DROP",
    "tcp_rejection_method": "TCP_RST",
    "dns_response_strategy": "A_0_0_0_0"
  },
  "network_rules": {
