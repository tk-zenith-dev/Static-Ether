  "metadata": {
    "name": "Publicidad y Anuncios",
    "version": "1.1.20",
    "author": "TK-Zenith Core Security",
    "license": "GPL-3.0",
    "homepage": "https://github.com/tk-zenith-dev/Static-Ether",
    "created_at": "2026-11-22T00:00:00Z",
    "updated_at": "2026-11-22T00:00:00Z",
    "category": "advertising",
    "description": {
      "es": "Bloqueo quirúrgico de subastas publicitarias (RTB), redes de anuncios, rastreadores intersticiales y servidores de banners globales.",
      "en": "Surgical blocking of real-time ad bidding (RTB), ad networks, interstitial trackers, and global banner servers.",
      "pt": "Bloqueio cirúrgico de leilões de anúncios (RTB), redes de publicidade e servidores globais."
    },
    "compatibility": {
      "min_engine_version": "2.0.0",
      "requires_root": false,
      "supported_architectures": [
        "arm64-v8a",
        "armeabi-v7a",
        "x86",
        "x86_64"
      ]
    }
  },
  "scope": {
    "type": "global",
    "target_packages": [],
    "target_package_signatures_sha256": [],
    "excluded_packages": [
      "com.tkzenith.staticether",
      "com.android.vending",
      "com.google.android.gms",
      "com.google.android.gsf",
      "com.android.providers.downloads"
    ]
  },
  "execution_policy": {
    "default_action": "ALLOW",
    "mode": "active_enforcement",
    "priority_weight": 900,
    "fast_path_enabled": true,
    "mtu_hint": 16384,
    "ipv6_handling": "STRICT_DUAL_STACK",
    "quic_policy": "VERSION_NEGOTIATION",
    "tcp_rejection_method": "TCP_RST",
    "dns_response_strategy": "A_0_0_0_0"
  },
  "network_rules": {
    "l3_cidr_rules": [],
    "l4_transport_rules": [
      {
        "protocol": "TCP",
        "ports": [
          853
        ],
        "action": "BLOCK",
        "description": "Neutraliza DoT (DNS Privado)"
      },
      {
        "protocol": "UDP",
        "ports": [
          443
        ],
        "action": "VERSION_NEGOTIATION",
        "description": "Degrada QUIC (HTTP/3) a TCP mediante negociación RFC 9000"
      }
